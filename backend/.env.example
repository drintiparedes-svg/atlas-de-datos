# Backend del módulo Proyectos (copiar a .env y exportar, o definir en el servicio de hosting)
# Base de datos: PostgreSQL en Neon (decisión D11 aplicada). Sin esta variable se usa sqlite:///data/atlas.db
DATABASE_URL=postgresql://usuario:clave@ep-xxxxx.aws.neon.tech/atlas?sslmode=require
# Token compartido obligatorio fuera de localhost (cabecera X-Atlas-Token)
ATLAS_API_TOKEN=cambiar-por-un-secreto-largo
# Orígenes permitidos para el visor (separados por coma)
ATLAS_CORS_ORIGINS=http://127.0.0.1:5173,https://atlas-de-datos.vercel.app
# Carpeta de archivos subidos (fuera de la base de datos), tamaño máximo por archivo
ATLAS_UPLOAD_DIR=./data/uploads
ATLAS_MAX_UPLOAD_MB=25
# IA apagada por defecto: sin llamadas de red. Para modelos abiertos locales: AI_ENABLED=true y ATLAS_EMBEDDINGS=st o ollama
AI_ENABLED=false
ATLAS_EMBEDDINGS=hash
