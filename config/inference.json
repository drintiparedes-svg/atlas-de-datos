      ],
      "code_patterns": [
        "^[A-Z]\\d{2}(\\.\\d{1,2})?$",
        "^C\\d{2}\\.\\d$",
        "^\\d{4}/\\d$",
        "^[cyp]?T[0-4isx][a-c]?N[0-3x][a-c]?M[01x]$"
